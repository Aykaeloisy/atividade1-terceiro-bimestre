programa
{
	
	funcao inicio()
	{
		 inteiro i

        escreva("Números ímpares entre 1 e 50:\n")

        // Loop de 1 até 50
        para (i = 1; i <= 50; i++)
        {
            // Verifica se o número é ímpar
            se (i % 2 != 0){
            
                escreva(i, "\n")
            }
        }
	}
}

